# Production environment for every EXIM service + the gateway.
# Copy to /opt/exim/exim.env on the server, fill in real values, then: chmod 600 /opt/exim/exim.env
# Every service reads these (systemd EnvironmentFile). They MUST be identical across all services.

# --- MongoDB Atlas: one cluster, each service writes to its own database ---
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# --- JWT: the SAME secret across all services so they validate each other's tokens. ---
# Generate once:  openssl rand -base64 48
JWT_SECRET=<paste-a-long-random-48-byte-secret>

# --- Run with the prod profile ---
SPRING_PROFILES_ACTIVE=prod

# --- Platform admin bootstrap (identity-service) ---
# The startup seeder creates this admin if it doesn't exist. CHANGE THE PASSWORD.
PLATFORM_ADMIN_EMAIL=admin@hirkaniexim.com
PLATFORM_ADMIN_PASSWORD=<a-strong-password>
PLATFORM_ADMIN_NAME=Platform Admin
# Secret guarding POST /api/v1/auth/bootstrap-admin (out-of-band admin creation).
ADMIN_BOOTSTRAP_SECRET=<a-long-random-string>

# --- Inter-service URLs: all services run on this one VM, so localhost defaults are correct.
# Only override if you split services across hosts. (Gateway already defaults each to localhost.)
