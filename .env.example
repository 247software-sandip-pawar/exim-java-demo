# Copy to .env for local use, or set these in your cloud environment.
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes-please

# ---- Per-module databases (one PostgreSQL DB per module) ----
# Used only by the 'prod' profile. The 'dev' profile defaults to
# localhost:5432 / postgres / postgres (see application-dev.yml).

# Phase 1 — identity module
IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/exim_identity
IDENTITY_DB_USER=postgres
IDENTITY_DB_PASSWORD=postgres
